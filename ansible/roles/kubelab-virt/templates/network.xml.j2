<network>
    <name>{{ item.name }}</name>
    <forward mode="{{ item.mode }}"/>
    <bridge name="{{ item.bridge }}" stp="on" delay="0"/>
    <ip address="{{ item.gateway }}" netmask="{{ item.netmask }}">
        <dhcp>
            <range start="{{ item.dhcp_start }}" end="{{ item.dhcp_end }}"/>
        </dhcp>
    </ip>
</network>

